{
  "$schema": "node_modules/turbo/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "web#dev": {
      "persistent": true,
      "cache": false,
      "env": ["VITE_*"],
      "with": ["api#dev"],
    },
    "api#dev": {
      "persistent": true,
      "cache": false,
      "env": ["DB_URI"]
    }    
  }
}
