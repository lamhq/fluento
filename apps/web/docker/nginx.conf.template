server {
  listen 80;
  
  # Serve static files from /app directory 
  root /app;
  index index.html;

  # Proxy API requests, remove /api prefix
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # SPA routing: return index.html for non-static requests
  location / {
    try_files $uri /index.html;
  }
}
