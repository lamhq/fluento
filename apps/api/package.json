    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "cache-manager": "^7.2.9",
    "langchain": "^1.5.10",
    "mongoose": "^8.24.3",
    "nestjs-cls": "^7.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
