generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Exercise {
  id                String                   @id @default(auto()) @map("_id") @db.ObjectId
  topics            String[]
  scenario          String
  learnerRole       String
  counterpartRole   String
  prompts           String[]
  expectedResponses ExpectedResponse[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  learnerPractices  LearnerExercisePractice[] @relation("ExercisePractice")

  @@map("exercises")
}

type ExpectedResponse {
  content String
  style   String[]
}

model LearnerExercisePractice {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  learnerId     String
  exerciseId    String    @db.ObjectId
  practiceCount Int       @default(0)
  lastPracticeAt DateTime?
  exercise      Exercise  @relation("ExercisePractice", fields: [exerciseId], references: [id])

  @@unique([learnerId, exerciseId])
  @@map("learner_exercise_practices")
}

model ResponseSubmission {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  learnerId   String
  exerciseId  String              @db.ObjectId
  response    String
  createdAt   DateTime            @default(now())
  evaluation  EvaluationFeedback?

  @@map("response_submissions")
}

type EvaluationFeedback {
  feedback             String
  score                Int
  correctness          CorrectnessEvaluation?
  appropriateness      AppropriatenessEvaluation?
}

type CorrectnessEvaluation {
  score             Int
  feedback          String
  correctedSentence String
  fixes             String[]
}

type AppropriatenessEvaluation {
  score              Int
  feedback           String
  clarity            AppropriatenessDetail
  politeness         AppropriatenessDetail
  tone               AppropriatenessDetail
}

type AppropriatenessDetail {
  score    Int
  feedback String
}
