generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Exercise {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  sentences Sentence[]
  prompts   Prompt[]
  topics    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("exercises")
}

type Sentence {
  content    String
  style      String
  meaning    String?
}

type Prompt {
  content     String
  style       String
  meaning     String?
}
